# Docker Compose reads a copied .env automatically. For dotnet run, export
# these variables in your shell or use .NET user-secrets instead.
POSTGRES_PASSWORD=local-development
Jwt__Key=replace-with-a-random-secret-of-at-least-32-characters
Google__ClientId=
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=Get Your Gigs <hello@getyourgigs.example>
# Hosted PostgreSQL example (export for dotnet; compose uses its own database):
# ConnectionStrings__Database=Host=your-host;Database=getyourgigs;Username=your-user;Password=your-password;SSL Mode=VerifyFull

# Render testing: enter real values in Render, never commit them.
# Hosting__RenderProxy=true  # Render only; requires platform-provided RENDER=true
# GYG_MIGRATE_ON_START=true  # Container startup only, single-instance testing
# Storage__Provider=Supabase
# Storage__Supabase__Url=https://your-project.supabase.co
# Storage__Supabase__ServiceRoleKey=your-legacy-service_role-key
# Storage__Supabase__Bucket=gyg-photos
# Optional HTTPS email delivery; when absent, Google sign-in is required on Render.
# Email__Resend__ApiKey=re_your_key
# Email__From=Get Your Gigs <signin@your-verified-domain.example>

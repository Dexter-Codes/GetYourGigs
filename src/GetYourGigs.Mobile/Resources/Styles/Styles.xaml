<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
>
    <ControlTemplate x:Key="BentoSurface">
        <Border
            BackgroundColor="{StaticResource Surface}"
            Stroke="{StaticResource Line}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 22"
        >
            <ContentPresenter />
        </Border>
    </ControlTemplate>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="SafeAreaEdges" Value="All" />
    </Style>
    <Style TargetType="Label" x:Key="BodyLabel">
        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource BodyLabel}" />
    <Style TargetType="Label" x:Key="Heading" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>
    <Style TargetType="Label" x:Key="Caption" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style TargetType="Label" x:Key="Eyebrow" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.75" />
                            <Setter Property="Scale" Value="0.97" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
    <Style TargetType="Button" x:Key="OutlineButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="BorderColor" Value="{StaticResource Line}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="120" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Manrope" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="TitleColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="Border" x:Key="SurfaceBorder">
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    </Style>
    <Style TargetType="Border" BasedOn="{StaticResource SurfaceBorder}" />
    <Style TargetType="Border" x:Key="InputBorder" BasedOn="{StaticResource SurfaceBorder}">
        <Setter Property="BackgroundColor" Value="{StaticResource InputSurface}" />
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="Padding" Value="12,2" />
    </Style>
</ResourceDictionary>

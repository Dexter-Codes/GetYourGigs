<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GetYourGigs.Mobile.Views.ThreadPage"
    x:DataType="vm:ThreadViewModel"
    Title="Messages"
    xmlns:vm="clr-namespace:GetYourGigs.Mobile.ViewModels"
>
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <VerticalStackLayout Padding="22,12" Spacing="5">
            <Label
                Text="{Binding Heading}"
                FontFamily="Manrope"
                FontSize="25"
                FontAttributes="Bold"
            />
            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
            <Label
                Text="REPLY WHENEVER YOU’RE FREE"
                Style="{StaticResource Eyebrow}"
                FontSize="11"
            />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessage">
                    <Border
                        Padding="14,11"
                        Margin="18,6"
                        MaximumWidthRequest="290"
                        HorizontalOptions="{Binding Alignment}"
                        BackgroundColor="{Binding Background}"
                        StrokeThickness="0"
                    >
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding Text}" FontSize="12" LineHeight="1.4" />
                            <Label
                                Text="{Binding Time}"
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                TextColor="{StaticResource Muted}"
                            />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label
            Grid.Row="2"
            Text="{Binding Error}"
            TextColor="{StaticResource Danger}"
            Margin="20,5"
            FontSize="11"
        />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="9" Padding="18,12">
            <Border Padding="10,0" Style="{StaticResource InputBorder}">
                <Entry Text="{Binding Text}" Placeholder="Type a message…" MaxLength="3000" />
            </Border>
            <Button
                Grid.Column="1"
                Text="➤"
                Command="{Binding SendCommand}"
                WidthRequest="46"
                Padding="0"
                CornerRadius="23"
                SemanticProperties.Description="Send message"
            />
        </Grid>
    </Grid>
</ContentPage>

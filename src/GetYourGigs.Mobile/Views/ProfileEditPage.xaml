<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:ns2="clr-namespace:GetYourGigs.Mobile.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GetYourGigs.Mobile.Views.ProfileEditPage"
    x:DataType="vm:ProfileEditViewModel"
    Title="Your talent profile"
    xmlns:views="clr-namespace:GetYourGigs.Mobile.Views"
    xmlns:vm="clr-namespace:GetYourGigs.Mobile.ViewModels"
>
    <ScrollView>
        <VerticalStackLayout Padding="23,20,23,40" Spacing="16">
            <Label Text="FIVE QUESTIONS. THEN YOU’RE LIVE." Style="{StaticResource Eyebrow}" />
            <Label
                Text="Make a little space&#10;for your brilliance."
                Style="{StaticResource Heading}"
            />
            <Label
                Text="Your listing is published immediately. Add the essentials now and make it yours later."
                Style="{StaticResource Caption}"
            />
            <Label Text="01 · What do you do best?" FontAttributes="Bold" />
            <Border Style="{StaticResource InputBorder}">
                <Entry
                    Text="{Binding Headline}"
                    Placeholder="Your professional headline"
                    MaxLength="100"
                />
            </Border>
            <Border Style="{StaticResource InputBorder}">
                <Picker
                    Title="Choose your category"
                    ItemsSource="{Binding CategoryOptions}"
                    SelectedItem="{Binding Category}"
                />
            </Border>
            <Label Text="02 · Where’s your home base?" FontAttributes="Bold" />
            <Border Style="{StaticResource InputBorder}">
                <Entry
                    Text="{Binding City}"
                    Placeholder="Mumbai, Bengaluru, or Remote"
                    MaxLength="80"
                />
            </Border>
            <Label Text="03 · What’s your starting rate? (₹ / gig)" FontAttributes="Bold" />
            <Border Style="{StaticResource InputBorder}">
                <Entry Text="{Binding Rate}" Keyboard="Numeric" />
            </Border>
            <Label Text="Use 0 to discuss pricing directly." Style="{StaticResource Caption}" />
            <Label Text="04 · What’s in your toolkit?" FontAttributes="Bold" />
            <Border Style="{StaticResource InputBorder}">
                <Entry Text="{Binding Skills}" Placeholder="Skills, separated by commas" />
            </Border>
            <Label Text="05 · Tell your story." FontAttributes="Bold" />
            <Border Style="{StaticResource InputBorder}">
                <Editor
                    Text="{Binding Bio}"
                    Placeholder="Your experience, your approach, and what makes working with you special…"
                    MaxLength="3000"
                />
            </Border>
            <Border Style="{StaticResource InputBorder}">
                <Picker
                    Title="Rate unit"
                    ItemsSource="{Binding RateUnits}"
                    SelectedItem="{Binding RateUnit}"
                />
            </Border>
            <ns2:PhotoEditorView />
            <HorizontalStackLayout Spacing="12">
                <Switch IsToggled="{Binding Available}" OnColor="{StaticResource Accent}" />
                <Label Text="Available for new gigs" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Publish / save my profile →" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Error}" TextColor="{StaticResource Danger}" FontSize="11" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Accent}"
            />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GetYourGigs.Mobile.Views.PhotoEditorView"
    x:DataType="vm:MediaEditorViewModel"
    xmlns:vm="clr-namespace:GetYourGigs.Mobile.ViewModels"
>
    <VerticalStackLayout Spacing="10">
        <Label Text="Photos (optional, up to 5)" Style="{StaticResource Caption}" />
        <FlexLayout BindableLayout.ItemsSource="{Binding Photos}" Wrap="Wrap">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border WidthRequest="85" HeightRequest="85" Margin="0,0,8,8" Padding="0">
                        <Grid>
                            <Image
                                Source="{Binding ., Converter={StaticResource MediaUrl}}"
                                Aspect="AspectFill"
                            />
                            <Button
                                Text="×"
                                FontSize="13"
                                WidthRequest="24"
                                HeightRequest="24"
                                MinimumHeightRequest="24"
                                Padding="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MediaEditorViewModel}},Path=RemovePhotoCommand}"
                                CommandParameter="{Binding .}"
                            />
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>
        <Button
            Text="Add a photo from your device"
            Style="{StaticResource OutlineButton}"
            Command="{Binding PickPhotoCommand}"
        />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border Style="{StaticResource InputBorder}">
                <Entry
                    Text="{Binding PhotoUrl}"
                    Keyboard="Url"
                    Placeholder="Or use an HTTPS photo URL"
                    FontSize="11"
                />
            </Border>
            <Button
                Grid.Column="1"
                Text="Add"
                Command="{Binding AddUrlCommand}"
                Style="{StaticResource OutlineButton}"
                Padding="12,6"
            />
        </Grid>
    </VerticalStackLayout>
</ContentView>
